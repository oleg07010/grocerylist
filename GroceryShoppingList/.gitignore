node_modules/
build/
.env
.env.local
.DS_Store

# Capacitor / iOS
# The native project (ios/) IS committed, but these are build artifacts / secrets:
ios/App/App/public/     # regenerated on every `npx cap sync` (copied web build)
ios/App/Pods/           # CocoaPods, restored via `pod install`
ios/App/build/
ios/build/
DerivedData/
*.xcuserstate
xcuserdata/
# Never commit App Store Connect / signing secrets:
*.p8
*.p12
*.mobileprovision

# Capacitor / Android
# The native project (android/) IS committed. Its own android/.gitignore already
# ignores build artifacts (build/, .gradle/, *.aab, local.properties, the copied
# web assets, etc.). Only the signing secrets are added here.
# (keystore.properties.example is a different filename, so it stays tracked.)
*.jks
*.keystore
keystore.properties

# Firebase native config (download via `firebase apps:sdkconfig`; see README → Security)
ios/App/App/GoogleService-Info.plist
android/app/google-services.json
