# Android release signing — LOCAL config for producing a signed .aab.
#
# 1. Generate an upload keystore (once), keeping the file + passwords backed up:
#      keytool -genkey -v -keystore grocerysync-upload.jks \
#        -keyalg RSA -keysize 2048 -validity 10000 -alias upload
# 2. Copy this file to `keystore.properties` (same folder) and fill in the values.
#    `keystore.properties` and *.jks are gitignored — never commit them.
# 3. `./gradlew bundleRelease` (or Android Studio) then emits a signed bundle.
#
# storeFile: absolute path to the .jks is simplest (file() here resolves relative
# to android/app otherwise).

storeFile=/absolute/path/to/grocerysync-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
